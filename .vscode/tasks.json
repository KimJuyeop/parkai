{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "boardIp",
      "type": "promptString",
      "description": "보드 IP",
      "default": "192.168.0.100"
    }
  ],
  "tasks": [
    {
      "label": "테스트",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest -q",
      "group": "test"
    },
    {
      "label": "개발 실행 (웹 8080 + 워커)",
      "type": "shell",
      "command": "${command:python.interpreterPath} tools/dev.py"
    },
    {
      "label": "개발 실행 (samples 재생)",
      "type": "shell",
      "command": "${command:python.interpreterPath} tools/dev.py --replay"
    },
    {
      "label": "보드로 코드 전송",
      "type": "shell",
      "command": "ssh root@${input:boardIp} mkdir -p /opt/parkai/dev && scp -r parkai examples pyproject.toml root@${input:boardIp}:/opt/parkai/dev/"
    }
  ]
}
