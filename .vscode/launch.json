{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "개발 실행 (웹 8080 + 워커, 실제 카메라)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/dev.py",
      "console": "integratedTerminal"
    },
    {
      "name": "개발 실행 (웹 8080 + 워커, samples 재생)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/dev.py",
      "args": ["--replay"],
      "console": "integratedTerminal"
    },
    {
      "name": "웹만 (8080)",
      "type": "debugpy",
      "request": "launch",
      "module": "parkai.web",
      "args": ["--port", "8080"],
      "env": { "PARKAI_CONFIG": "data/config.json", "PARKAI_RUN_DIR": "run", "PARKAI_SAMPLES": "samples" }
    }
  ]
}
