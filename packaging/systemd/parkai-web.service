[Unit]
Description=parkai web settings tool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=parkai
Group=parkai
WorkingDirectory=/opt/parkai/current
Environment=PYTHONUNBUFFERED=1
Environment=PARKAI_CONFIG=/var/lib/parkai/config.json
Environment=PARKAI_RUN_DIR=/run/parkai
Environment=PARKAI_STATIC=/opt/parkai/current/frontend
ExecStart=/opt/parkai/current/venv/bin/python -m parkai.web --port 80
# root 없이 80 포트 사용
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RuntimeDirectory=parkai
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
