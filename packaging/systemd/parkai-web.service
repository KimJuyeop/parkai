[Unit]
Description=parkai web settings tool
# 네트워크가 '완전히 연결'될 때까지 기다리지 않는다: 안 쓰는 이더넷 포트가 있으면 부팅 후 최대 2분 늦게 켜졌다
# (2026-11-19 평가보드). 카메라는 매 사이클 다시 부르고 보드 IP 도 보낼 때마다 구하므로 늦게 붙어도 괜찮다
After=network.target

[Service]
Type=simple
User=parkai
Group=parkai
WorkingDirectory=/opt/parkai/current
Environment=PYTHONUNBUFFERED=1
Environment=PARKAI_CONFIG=/var/lib/parkai/config.json
Environment=PARKAI_RUN_DIR=/run/parkai
Environment=PARKAI_MODELS=/var/lib/parkai/models
ExecStart=/opt/parkai/current/venv/bin/python -m parkai.web --port 80
# root 없이 80 포트 사용
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
RuntimeDirectory=parkai
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
